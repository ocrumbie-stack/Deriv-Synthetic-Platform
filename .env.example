APP_NAME="Deriv Synthetic Trading Platform"
DATABASE_URL="sqlite:///./trading_platform.db"
WEBHOOK_SECRET="change-me"
EXECUTION_MODE="demo"
EMERGENCY_STOP="false"

# Dashboard sign-in with Google - stays off until all three are set.
# ALLOWED_EMAILS is comma-separated. Changing SESSION_SECRET signs out every device.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAILS=""
SESSION_SECRET=""

DERIV_APP_ID=""

# Real account - required for EXECUTION_MODE=live (or switching to live from the dashboard)
DERIV_API_TOKEN=""
DERIV_ACCOUNT_ID=""

# Demo/virtual account - required for EXECUTION_MODE=demo (or switching to demo from the dashboard)
DERIV_DEMO_API_TOKEN=""
DERIV_DEMO_ACCOUNT_ID=""

DERIV_WS_URL="wss://ws.derivws.com/websockets/v3"
